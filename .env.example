# ---------------------------------------------------------------------------
# Contact form delivery (/api/contact)
#
# Without RESEND_API_KEY the form still validates and still reaches the server,
# but it cannot deliver: the visitor is shown an error pointing at the direct
# email address, and the full submission is written to the function log so it
# is never actually lost.
# ---------------------------------------------------------------------------

# https://resend.com/api-keys
RESEND_API_KEY=

# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Bee Balm Productions Website <website@beebalmproductions.com>"

# Where inquiries land.
CONTACT_TO_EMAIL=info@beebalmproductions.com

# ---------------------------------------------------------------------------
# Spam protection (Cloudflare Turnstile) — optional
#
# Both keys are created together at
# https://dash.cloudflare.com -> Turnstile -> Add widget. Free, no card.
#
# Leave BOTH blank and the form behaves as if Turnstile did not exist. Set
# both to turn it on. Setting only one is detected and logged rather than
# rejecting every visitor. The site key is inlined at BUILD time.
# ---------------------------------------------------------------------------

PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
