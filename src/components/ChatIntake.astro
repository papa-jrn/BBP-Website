---
---

<div class="chat-intake" data-chat-intake>
  <button type="button" class="chat-toggle" data-chat-toggle aria-label="Open chat intake">Chat With Bee Balm</button>
  <section class="chat-panel" data-chat-panel hidden>
    <h3>Quick Project Intake</h3>
    <p>Share a few details and we will follow up.</p>

    <form class="chat-form" data-chat-form>
      <input type="hidden" name="source" value="Chat intake" />
      <input type="hidden" name="started-at" data-started-at />
      <div class="hp" aria-hidden="true">
        <label for="chat-company-website">Leave this field empty</label>
        <input id="chat-company-website" name="company-website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <label>
        Name
        <input type="text" name="name" required />
      </label>
      <label>
        Email
        <input type="email" name="email" required />
      </label>
      <label>
        Project type
        <select name="project_type">
          <option>Marketing website</option>
          <option>Web application</option>
          <option>Website redesign</option>
          <option>Brand + website package</option>
        </select>
      </label>
      <label>
        Budget range
        <select name="budget">
          <option>Working it out — need a recommendation</option>
          <option>Under $5,000</option>
          <option>$5,000–$15,000</option>
          <option>$15,000–$30,000</option>
          <option>$30,000–$60,000</option>
          <option>$60,000+</option>
        </select>
      </label>
      <label>
        Project notes
        <textarea name="project_goals" rows="3" required></textarea>
      </label>

      <button type="submit" class="button primary">Send Intake</button>
      <p class="chat-status" data-chat-status></p>
    </form>
  </section>
</div>

<script>
  const intakeRoot = document.querySelector('[data-chat-intake]');
  if (intakeRoot) {
    const toggle = intakeRoot.querySelector('[data-chat-toggle]');
    const panel = intakeRoot.querySelector('[data-chat-panel]');
    const form = intakeRoot.querySelector('[data-chat-form]');
    const status = intakeRoot.querySelector('[data-chat-status]');

    toggle?.addEventListener('click', () => {
      if (panel?.hasAttribute('hidden')) {
        panel.removeAttribute('hidden');
      } else {
        panel?.setAttribute('hidden', 'true');
      }
    });

    // Stamped on open rather than at submit, so the timing floor in
    // /api/contact measures how long the form was actually in front of them.
    const startedAt = form?.querySelector('[data-started-at]');
    if (startedAt instanceof HTMLInputElement) startedAt.value = String(Date.now());

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (status) status.textContent = 'Sending...';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        const result = await res.json();

        if (result.ok) {
          form.reset();
          if (startedAt instanceof HTMLInputElement) startedAt.value = String(Date.now());
          if (status) {
            status.textContent = 'Thanks. That reached us — we will follow up within one business day.';
          }
          return;
        }

        // Surface the real reason. The previous version reported every
        // outcome as a generic failure, including a missing email address.
        const messages = result.errors
          ? Object.values(result.errors)
          : [result.message ?? 'Something went wrong. Please try again.'];
        if (status) status.textContent = String(messages[0]);
      } catch (error) {
        if (status) {
          status.textContent = 'We could not reach the server. Please email info@beebalmproductions.com.';
        }
      }
    });
  }
</script>