---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
---

<BaseLayout
  title="Bee Balm Productions | Web and Software for Public-Serving Organizations"
  description="Thirty years of web and software work across health systems, federally funded programs, municipalities and nonprofits in New England — delivered in weeks, not quarters."
>
  <section class="container hero reveal">
    <div class="hero-grid">
      <div>
        <h1>Websites and tools for organizations that answer to the public.</h1>
        <p>
          Thirty years across health systems, federally funded clinical training, municipalities and
          nonprofits — including site templates still running in production at Dartmouth Health.
          Now delivered in weeks rather than quarters.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/portfolio">See the Work</a>
          <a class="button ghost" href="/contact">Start a Project</a>
        </div>
      </div>

      <div class="hero-image-wrap">
        <img class="hero-image" src="/images/legacy/BeeOnThistle.jpg" alt="Bee on flower" />
        <div class="sticker a">Healthcare + Civic</div>
        <div class="sticker b">Weeks, Not Quarters</div>
      </div>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>Built by someone who has run the programs, not just the websites.</h2>
      <p>
        Two decades administering federally funded health and education programs — grant compliance,
        federal reporting, end-user support — alongside the web work those programs depended on.
      </p>
    </div>
    <div class="stats-grid">
      <article class="stat-card reveal">
        <strong>30 yrs</strong>
        <span>Web and multimedia, since 1996</span>
      </article>
      <article class="stat-card reveal">
        <strong>NIH · CDC</strong>
        <span>Federally funded platforms administered</span>
      </article>
      <article class="stat-card reveal">
        <strong>In production</strong>
        <span>Dartmouth Health templates, years on</span>
      </article>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>How a project runs</h2>
      <p>Four stages, written down, so you know what happens and when.</p>
    </div>
    <div class="infographic-flow">
      <article class="info-node reveal">
        <h3>01 Discover</h3>
        <p>Goals, users, and constraints.</p>
      </article>
      <article class="info-node reveal">
        <h3>02 Design</h3>
        <p>Wireframes, visuals, and interactions.</p>
      </article>
      <article class="info-node reveal">
        <h3>03 Build</h3>
        <p>Front-end, integrations, and QA.</p>
      </article>
      <article class="info-node reveal">
        <h3>04 Launch</h3>
        <p>Deploy, monitor, and optimize.</p>
      </article>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>What we do</h2>
      <p>
        Public-facing sites, internal tools, and the content strategy that decides what either one should say.
      </p>
    </div>
    <div class="feature-grid">
      <article class="value-card reveal">
        <h3>Clear Discovery</h3>
        <p>Goals, audience, scope and timeline agreed in writing before design starts.</p>
      </article>
      <article class="value-card reveal">
        <h3>Accessible By Default</h3>
        <p>Semantic structure, keyboard operation and contrast-checked color — the things public-sector procurement asks about.</p>
      </article>
      <article class="value-card reveal">
        <h3>Fast, Light Builds</h3>
        <p>Static sites that load in a fraction of a second, with no plugin maintenance and almost no hosting cost.</p>
      </article>
    </div>
    <div class="hero-actions">
      <a class="button primary" href="/portfolio">View Portfolio</a>
      <a class="button ghost" href="/about">About Bee Balm</a>
    </div>
  </section>

  <TestimonialCarousel />
</BaseLayout>