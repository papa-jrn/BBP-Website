---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
---

<BaseLayout
  title="Bee Balm Productions | Applications, Websites and the Content That Fills Them"
  description="Custom web applications, websites and the campaigns around them for healthcare, education and nonprofit organizations — writing included. Led by Josh Nelson, with more than 20 years inside the programs behind the work."
>
  <section class="container hero reveal">
    <div class="hero-grid">
      <div>
        <h1>Applications, websites, and the words that carry them.</h1>
        <p>
          Bee Balm builds internal tools, complex websites and the campaigns around them for
          healthcare, education and nonprofit organizations — and writes the words that go in them,
          which most studios leave to the client. Josh Nelson leads each engagement, bringing more
          than 20 years of understanding the people, programs and constraints behind the work.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/portfolio">Explore the Work</a>
          <a class="button ghost" href="/contact">Discuss Your Project</a>
        </div>
      </div>

      <div class="hero-image-wrap">
        <a class="hero-project-preview" href="/portfolio/events-to-cover" aria-label="View the Events to Cover application case study">
          <img class="hero-image" src="/images/events-to-cover-board.jpg" alt="The Story Lead Board: a dated rundown of community events filtered by town and type, each lead carrying a suggested story angle, with assignments claimed by name so the team can see who is covering what." width="1070" height="772" />
          <span class="hero-project-caption">Custom application · Events to Cover</span>
        </a>
        <div class="sticker b">Applications + Websites</div>
      </div>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>Built by someone who understands the work behind the website.</h2>
      <p>
        More than 20 years working with healthcare, education, and nonprofit organizations means less
        time explaining the context and more time solving the right problem.
      </p>
    </div>
    <div class="stats-grid">
      <article class="stat-card reveal">
        <strong>20+ years</strong>
        <span>Working with healthcare, education, and nonprofits</span>
      </article>
      <article class="stat-card reveal">
        <strong>NIH · CDC</strong>
        <span>Federally funded platforms administered</span>
      </article>
      <article class="stat-card reveal">
        <strong>Custom tools</strong>
        <span>Designed around real staff workflows</span>
      </article>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>How a project runs</h2>
      <p>Four stages, written down, so you know what happens and when.</p>
    </div>
    <div class="infographic-flow">
      <article class="info-node reveal">
        <h3>01 Discover</h3>
        <p>Goals, users, and constraints.</p>
      </article>
      <article class="info-node reveal">
        <h3>02 Design</h3>
        <p>Wireframes, visuals, and interactions.</p>
      </article>
      <article class="info-node reveal">
        <h3>03 Build</h3>
        <p>Front-end, integrations, and QA.</p>
      </article>
      <article class="info-node reveal">
        <h3>04 Launch</h3>
        <p>Deploy, monitor, and optimize.</p>
      </article>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>Applications, websites and campaigns built around real work</h2>
      <p>
        From an internal workflow tool to an institutional rebuild to the campaign that launches it —
        starting with the people who use it and the job it needs to do.
      </p>
    </div>
    <div class="feature-grid">
      <article class="value-card reveal">
        <h3>Custom Applications</h3>
        <p>Purpose-built tools that help teams coordinate assignments, events, information, and day-to-day work.</p>
      </article>
      <article class="value-card reveal">
        <h3>Complex Websites</h3>
        <p>Institutional and nonprofit websites shaped around real content, multiple stakeholders, accessibility, and long-term use.</p>
      </article>
      <article class="value-card reveal">
        <h3>Content and Campaigns</h3>
        <p>Messaging, copywriting and launch campaigns. Most studios hand back an empty shell and leave the writing to you; we deliver it filled in.</p>
      </article>
      <article class="value-card reveal">
        <h3>Experienced Project Leadership</h3>
        <p>Josh leads the work directly and brings in trusted collaborators when a project needs additional expertise.</p>
      </article>
    </div>
    <div class="hero-actions">
      <a class="button primary" href="/portfolio">View Portfolio</a>
      <a class="button ghost" href="/about">About Bee Balm</a>
    </div>
  </section>

  <TestimonialCarousel />
</BaseLayout>
