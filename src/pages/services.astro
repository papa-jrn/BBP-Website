---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pricingTiers, processSteps, serviceItems } from '../data/site';
---

<BaseLayout title="Services | Bee Balm Productions" description="Strategic web design and web app development services with a clear step-by-step process.">
  <section class="container hero reveal">
    <div class="hero-grid">
      <div>
        <h1>Services built for momentum.</h1>
        <p>
          We mix strategy, design, development, and launch support into one collaborative workflow so your project keeps moving.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/contact">Book an Intro Call</a>
          <a class="button ghost" href="#process">Jump to Process</a>
        </div>
      </div>
      <div class="hero-image-wrap">
        <img class="hero-image" src="/images/legacy/DSC_1173.jpg" alt="Mountain horizon" />
        <div class="sticker b">Infographic-Led UX</div>
      </div>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>Core service tracks</h2>
      <p>Choose a focused engagement or combine tracks into a complete web app build.</p>
    </div>
    <div class="card-grid">
      {serviceItems.map((item) => (
        <article class="service-card reveal">
          <div class="service-icon">{item.icon}</div>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container curve-band" id="process">
    <div class="section-head reveal">
      <h2>Our step-by-step web app process</h2>
      <p>
        Each phase is written down so you know what happens and when, from discovery through post-launch growth.
      </p>
    </div>

    <div class="process-shell reveal">
      <div class="process-flow">
        {processSteps.map((step, index) => (
          <article class="process-step reveal" data-step={index + 1}>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
            <span class="process-chip">{step.chip}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>Engagement infographic</h2>
      <p>Two simple ways to work with us depending on your timeline and internal team.</p>
    </div>
    <div class="feature-grid">
      <article class="pod-card reveal">
        <h3>Sprint Mode</h3>
        <p>Fast 2-4 week focused build cycle for urgent initiatives.</p>
      </article>
      <article class="pod-card reveal">
        <h3>Studio Partner</h3>
        <p>Ongoing monthly design + development support for scaling teams.</p>
      </article>
    </div>
  </section>

  <section class="container curve-band" id="pricing">
    <div class="section-head reveal">
      <h2>What it costs</h2>
      <p>
        Fixed fees, published, so you can tell before you call whether we are in your range.
        Every project still starts with a free conversation and a written proposal.
      </p>
    </div>
    <div class="pricing-grid">
      {
        pricingTiers.map((tier) => (
          <article class:list={['panel', 'reveal', 'price-card', { 'price-card--featured': 'featured' in tier && tier.featured }]}>
            <h3>{tier.name}</h3>
            <p class="price-card__price">
              <strong>{tier.price}</strong>
              <span>{tier.unit}</span>
            </p>
            <p class="price-card__best">{tier.best}</p>
            <ul class="price-card__includes">
              {tier.includes.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
    <div class="panel reveal pricing-note">
      <h3>How these are priced</h3>
      <p>
        These are fixed fees rather than an hourly rate, because you are buying a finished thing
        and not an afternoon. Work outside a project — ad-hoc changes for clients without a care
        plan — is $125 per hour. Advisory work on grant-funded programs, where the useful thing is
        two decades of federal reporting and compliance experience rather than the build, is $175
        to $225 per hour.
      </p>
      <p>
        Ranges exist because content volume and the number of people who need to approve things
        move the number more than page count does. The proposal names one figure, and it is the
        figure you pay.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .price-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .price-card--featured {
    outline: 2px solid var(--honey);
    outline-offset: -2px;
  }

  .price-card__price {
    margin: 0.25rem 0 0;
  }

  .price-card__price strong {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.5rem;
    display: block;
    color: var(--honey);
    line-height: 1.1;
  }

  .price-card__price span {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .price-card__best {
    font-size: 0.92rem;
    opacity: 0.85;
  }

  .price-card__includes {
    margin: 0.5rem 0 0;
    padding-left: 1.05rem;
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }

  .pricing-note {
    margin-top: 1.25rem;
  }

  .pricing-note p {
    max-width: 68ch;
  }
</style>
