---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Bee Balm Productions" description="Meet Bee Balm Productions and learn how we blend strategy, design, and development.">
  <section class="container curve-band">
    <div class="two-col about-balance">
      <article class="panel reveal">
        <h2>About Bee Balm Productions</h2>
        <p>
          We are a creative web studio rooted in New Hampshire and built around collaboration, trust, and playful craftsmanship.
        </p>
        <p>
          Our projects blend strategic thinking, visual identity, and practical engineering so teams can launch with confidence.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/services">Our Services</a>
          <a class="button ghost" href="/owner">Meet Josh</a>
        </div>
      </article>
      <article class="about-hero-image reveal">
        <img src="/images/legacy/waterfall.jpg" alt="Waterfall landscape" />
      </article>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>Studio model infographic</h2>
      <p>How we keep projects creative and structured at the same time.</p>
    </div>
    <div class="infographic-pods">
      <article class="pod-card reveal">
        <h3>Strategy Pod</h3>
        <p>Goals, scope, roadmap</p>
      </article>
      <article class="pod-card reveal">
        <h3>Design Pod</h3>
        <p>Brand, interface, motion</p>
      </article>
      <article class="pod-card reveal">
        <h3>Build Pod</h3>
        <p>Code, QA, deployment</p>
      </article>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>Our philosophy</h2>
      <p>Great digital experiences should be useful, beautiful, and easy to manage long after launch.</p>
    </div>
    <div class="feature-grid">
      <article class="value-card reveal">
        <h3>Listen First</h3>
        <p>We start by understanding your mission, users, and constraints before proposing solutions.</p>
      </article>
      <article class="value-card reveal">
        <h3>Design for Clarity</h3>
        <p>We use visual hierarchy and playful interfaces to help people find what they need fast.</p>
      </article>
      <article class="value-card reveal">
        <h3>Build for Growth</h3>
        <p>Every site is structured to evolve with your services, marketing, and internal operations.</p>
      </article>
    </div>
  </section>
</BaseLayout>