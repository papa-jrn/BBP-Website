---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * The form posts to /api/contact, a serverless route in this repo. It used to
 * post to formsubmit.co, a free relay that accepted submissions, showed the
 * visitor a success page on its own domain, and then quietly stopped
 * delivering for three weeks. Nothing about that was visible from here.
 *
 * It works three ways now:
 *   with JavaScript  posted in the background, the outcome swapped in place
 *   without it       posted normally, redirecting to /thank-you
 *   misconfigured    the route says so and points at the direct email, and
 *                    writes the whole submission to the log so it survives
 */

/** Public by design and inlined at build time. Absent means no widget. */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<BaseLayout title="Contact | Bee Balm Productions" description="Talk with Bee Balm Productions about your web design or web app project.">
  <section class="container curve-band">
    <div class="section-head reveal">
        <h2>Tell us what your team needs to get done</h2>
      <p>
          Bee Balm leads custom application and complex website projects for healthcare, education, and nonprofit organizations. Focused engagements start at $5,000; larger projects are scoped to requirements.
      </p>
    </div>

    <div class="contact-grid">
      <article class="contact-card reveal">
        <h3>Contact details</h3>
        <ul class="contact-list">
          <li><strong>Phone:</strong> <a href="tel:+16035580315">603-558-0315</a></li>
          <li><strong>Email:</strong> <a href="mailto:info@beebalmproductions.com">info@beebalmproductions.com</a></li>
          <li><strong>Location:</strong> Claremont, New Hampshire</li>
          <li><strong>Region:</strong> New England and remote nationwide</li>
        </ul>
        <div class="hero-actions">
          <a class="button primary" href="mailto:info@beebalmproductions.com">Send Email</a>
          <a class="button ghost" href="https://www.facebook.com/beebalmproductions/" target="_blank" rel="noreferrer">Facebook</a>
        </div>
      </article>

      <article class="contact-card reveal">
        <h3>Project inquiry form</h3>
        <form class="contact-form" id="contact-form" action="/api/contact" method="post" data-contact-form>
          <input type="hidden" name="source" value="Contact form" />

          <div class="form-row">
            <label>
              Name
              <input type="text" name="name" required />
            </label>
            <label>
              Email
              <input type="email" name="email" required />
            </label>
          </div>

          <div class="form-row">
            <label>
              Organization
              <input type="text" name="organization" />
            </label>
            <label>
              What are you after?
              <select name="offer">
                <option>Not sure yet — tell me what fits</option>
                <option>Custom application or internal tool</option>
                <option>Institutional or nonprofit website</option>
                <option>RFP or procurement project</option>
                <option>Focused engagement (starting at $5,000)</option>
                <option>Content and campaigns ($4,500–$9,000)</option>
                <option>Ongoing support</option>
                <option>Something else</option>
              </select>
            </label>
          </div>

          <label>
            Project goals
            <textarea name="project_goals" rows="5" required></textarea>
          </label>

          <div class="form-row">
            <label>
              Budget range
              <select name="budget">
                <option>Working it out — need a recommendation</option>
                <option>Under $5,000</option>
                <option>$5,000–$15,000</option>
                <option>$15,000–$30,000</option>
                <option>$30,000–$60,000</option>
                <option>$60,000+</option>
              </select>
            </label>
            <label>
              Desired timeline
              <input type="text" name="timeline" placeholder="Example: launch in 8 weeks" />
            </label>
          </div>

          <div class="form-row">
            <label>
              Is this a formal RFP or procurement?
              <select name="procurement">
                <option>No — we can just decide</option>
                <option>Yes — there is an RFP document</option>
                <option>Likely, but not issued yet</option>
              </select>
            </label>
            <label>
              Submission or decision deadline
              <input type="text" name="deadline" placeholder="Example: proposals due Dec 12" />
            </label>
          </div>

          {/* Spam traps: a honeypot nobody can see, and when the form was opened. */}
          <div class="hp" aria-hidden="true">
            <label for="company-website">Leave this field empty</label>
            <input id="company-website" name="company-website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="started-at" data-started-at />

          {
            turnstileSiteKey && (
              <div class="turnstile-field">
                <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" />
                <noscript>
                  <p class="form-note">
                    This verification check needs JavaScript. With it switched off, please email
                    <a href="mailto:info@beebalmproductions.com">info@beebalmproductions.com</a>.
                  </p>
                </noscript>
              </div>
            )
          }

          <div class="form-outcome" data-contact-outcome aria-live="polite"></div>

          <button class="button primary" type="submit" data-contact-submit>Submit Inquiry</button>
          <p class="form-note">
            Goes straight to our own inbox — no third-party form service. Prefer to write it
            yourself? Email <a href="mailto:info@beebalmproductions.com">info@beebalmproductions.com</a>.
          </p>
        </form>
      </article>
    </div>
  </section>

  <section class="container curve-band">
    <div class="two-col">
      <article class="contact-card reveal">
        <img class="contact-photo" src="/images/legacy/Bright-Red-bee-balm.jpg" alt="Bee balm flower" />
        <p>
          Prefer a quick intro call first? Share your goals and timeline and we will recommend a realistic next step.
        </p>
      </article>
      <article class="contact-card reveal">
        <h3>What happens after you contact us</h3>
        <p>
          We typically reply within one business day. Then we schedule a short intro call, confirm scope, and send a tailored plan.
        </p>
      </article>
    </div>
  </section>

  <section class="container curve-band">
    <div class="section-head reveal">
      <h2>Kickoff infographic</h2>
      <p>What happens right after you reach out.</p>
    </div>
    <div class="infographic-flow">
      <article class="info-node reveal"><h3>Intro Call</h3><p>30-minute fit and goals conversation.</p></article>
      <article class="info-node reveal"><h3>Proposal</h3><p>Scope, timeline, and recommendations.</p></article>
      <article class="info-node reveal"><h3>Project Start</h3><p>Kickoff workshop and first sprint begins.</p></article>
      <article class="info-node reveal"><h3>Weekly Rhythm</h3><p>Consistent updates and visible progress.</p></article>
    </div>
  </section>
</BaseLayout>

{
  turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  const form = document.querySelector('[data-contact-form]');

  if (form instanceof HTMLFormElement) {
    const outcome = form.querySelector('[data-contact-outcome]');
    const button = form.querySelector('[data-contact-submit]');
    const startedAt = form.querySelector('[data-started-at]');

    // Only meaningful with scripting on, which is the only case that can be
    // submitted fast enough for the timing floor to mean anything.
    if (startedAt instanceof HTMLInputElement) startedAt.value = String(Date.now());

    const say = (html, kind) => {
      if (!outcome) return;
      outcome.className = `form-outcome form-outcome--${kind}`;
      outcome.innerHTML = html;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }
      say('', 'quiet');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        const result = await response.json();

        if (result.ok) {
          form.innerHTML =
            '<h3>Thank you — that reached us.</h3>' +
            '<p>Your inquiry is in our inbox. We read every one personally, and you will hear ' +
            'back within one business day.</p>';
          return;
        }

        const messages = result.errors
          ? Object.values(result.errors)
          : [result.message ?? 'Something went wrong. Please try again.'];

        say('<ul>' + messages.map((m) => `<li>${m}</li>`).join('') + '</ul>', 'error');
      } catch {
        // The request never completed, so nothing was sent and nothing was
        // logged. Give them an address rather than a spinner.
        say(
          '<p>We could not reach the server. Please email ' +
            '<a href="mailto:info@beebalmproductions.com">info@beebalmproductions.com</a> ' +
            'and we will pick it up from there.</p>',
          'error'
        );
      } finally {
        if (button instanceof HTMLButtonElement && document.contains(button)) {
          button.disabled = false;
          button.textContent = 'Submit Inquiry';
        }
        // A Turnstile token is good for one submission only.
        if (window.turnstile && document.querySelector('.cf-turnstile')) window.turnstile.reset();
      }
    });
  }
</script>

<style>
  .turnstile-field {
    min-height: 65px;
    margin-bottom: 0.5rem;
  }

  .form-outcome:empty {
    display: none;
  }

  .form-outcome--error {
    border-left: 3px solid var(--accent, #8c1d33);
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    background: rgba(140, 29, 51, 0.06);
    border-radius: 0 8px 8px 0;
  }

  .form-outcome ul {
    margin: 0;
    padding-left: 1.1rem;
  }
</style>

